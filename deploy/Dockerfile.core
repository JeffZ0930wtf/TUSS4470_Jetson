# Digest pinning and the hash-locked dependency export keep the V1 runtime
# reproducible on amd64 and arm64.
FROM public.ecr.aws/docker/library/python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a

ARG VERSION=1.0.0
ARG VCS_REF=unknown
LABEL org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$VCS_REF"

WORKDIR /opt/usac
ENV PYTHONPATH=/opt/usac/packages/usac_protocol/src:/opt/usac/packages/usac_runtime/src \
    PYTHONUNBUFFERED=1

COPY requirements-container.lock.txt ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-container.lock.txt
COPY pyproject.toml README.md ./
COPY packages packages
COPY protocol protocol

ENTRYPOINT ["python", "-m", "usac_runtime.core_server"]
